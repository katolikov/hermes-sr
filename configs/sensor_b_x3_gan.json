{
    "mode": "B",
    "upscale": 3,
    "dataset": "sensor_video",
    "init_from": "checkpoints/sensor_b_x3_iter20000.pt",
    "patch_size": 96,
    "batch_size": 12,
    "max_iters": 10000,
    "eval_every": 1000,
    "save_every": 2000,
    "log_interval": 200,
    "lr_g": 0.0001,
    "lr_d": 0.0001,
    "gan_weight": 0.1,
    "disc_feat": 32,
    "ema_decay": 0.999,
    "weights": {
        "pixel": 1.0,
        "perceptual": 0.1,
        "spectral": 0.0,
        "temporal": 0.25,
        "distill": 0.0
    },
    "block_type": "ecb",
    "use_recurrent_state": true,
    "anchor_mode": "bilinear",
    "blur_max": 0.8,
    "data_root": "~/datasets",
    "set5_root": "~/datasets",
    "eval_noise_sigma": 25.0,
    "ckpt_prefix": "sensor_b_x3_gan_iter",
    "out_dir": "checkpoints",
    "num_workers": 0
}