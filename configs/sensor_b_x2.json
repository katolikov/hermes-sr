{
    "mode": "B",
    "upscale": 2,
    "dataset": "sensor_video",
    "patch_size": 96,
    "batch_size": 16,
    "max_iters": 20000,
    "eval_every": 2000,
    "save_every": 5000,
    "log_interval": 200,
    "lr": 5e-4,
    "ema_decay": 0.999,
    "weights": {"pixel": 1.0, "perceptual": 0.0, "spectral": 0.0, "temporal": 0.25, "distill": 0.0},
    "temporal_warmup_iters": 2000,
    "block_type": "ecb",
    "ecb_depth_multiplier": 2.0,
    "use_recurrent_state": true,
    "anchor_mode": "bilinear",
    "blur_max": 0.8,
    "data_root": "~/datasets",
    "set5_root": "~/datasets",
    "eval_noise_sigma": 25.0,
    "ckpt_prefix": "sensor_b_x2_iter",
    "out_dir": "checkpoints",
    "use_perceptual": false,
    "amp": false,
    "num_workers": 0
}
